<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Package visibility for app labels (ADR-021): launcher-visible apps only, no QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <application>
        <!-- The bubble, the screen context and the insertion (DESIGN 5.1). isAccessibilityTool=false
             (true would get the app rejected/blocked, platform spike 2). Deliberately no SYSTEM_ALERT_WINDOW. -->
        <service
            android:name=".MurmurAccessibilityService"
            android:exported="false"
            android:label="${productName}"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/murmur_accessibility" />
        </service>
    </application>
</manifest>
