<?xml version="1.0" encoding="utf-8"?>
<!-- Test-only accessibility service: gives OverlayHost a real TYPE_ACCESSIBILITY_OVERLAY window token on the emulator
     (WP-03 acceptance "overlay on the emulator"), independent of WP-02's production service. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <service
            android:name="app.murmur.platform.overlay.OverlayTestService"
            android:exported="true"
            android:label="Overlay test service"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/overlay_test_service" />
        </service>
    </application>
</manifest>
